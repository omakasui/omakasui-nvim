#!/usr/bin/make -f

BUILD_HOME    := $(CURDIR)/debian/build-home
XDG_CONFIG_HOME := $(BUILD_HOME)/.config
XDG_DATA_HOME   := $(BUILD_HOME)/.local/share
XDG_STATE_HOME  := $(BUILD_HOME)/.local/state
XDG_CACHE_HOME  := $(BUILD_HOME)/.cache

STARTER_COMMIT := 803bc181d7c0d6d5eeba9274d9be49b287294d99
STARTER_SHA256 := b580d0bdb1654342dcf9f24fa1d4584bb91046a06dc1b6c866cbd06719b9dc7a
STARTER_DIR    := $(CURDIR)/debian/starter-$(STARTER_COMMIT)
STARTER_TAR    := $(CURDIR)/debian/starter.tar.gz

# Sanity floor for the restored plugin count.
MIN_PLUGINS := 40

SHARE_DIR := debian/omakasui-nvim/usr/share/omakasui-nvim

%:
	dh $@

# Overlays our config on the LazyVim starter, then caches the locked plugin set.
# Needs network and nvim on PATH.
override_dh_auto_build:
	rm -rf $(BUILD_HOME) $(STARTER_TAR) $(CURDIR)/debian/starter-*
	mkdir -p $(XDG_CONFIG_HOME) $(XDG_DATA_HOME) $(XDG_STATE_HOME) $(XDG_CACHE_HOME)
	curl -fsSL "https://github.com/LazyVim/starter/archive/$(STARTER_COMMIT).tar.gz" \
	  -o $(STARTER_TAR)
	echo "$(STARTER_SHA256)  $(STARTER_TAR)" | sha256sum -c -
	tar -xzf $(STARTER_TAR) -C $(CURDIR)/debian
	cp -r $(STARTER_DIR) $(XDG_CONFIG_HOME)/nvim
	cp -r lua/.    $(XDG_CONFIG_HOME)/nvim/lua/
	cp -r plugin/. $(XDG_CONFIG_HOME)/nvim/plugin/
	cp lazyvim.json    $(XDG_CONFIG_HOME)/nvim/lazyvim.json
	cp lazy-lock.json  $(XDG_CONFIG_HOME)/nvim/lazy-lock.json
	HOME=$(BUILD_HOME) \
	XDG_CONFIG_HOME=$(XDG_CONFIG_HOME) \
	XDG_DATA_HOME=$(XDG_DATA_HOME) \
	XDG_STATE_HOME=$(XDG_STATE_HOME) \
	XDG_CACHE_HOME=$(XDG_CACHE_HOME) \
	  nvim --headless "+Lazy! restore" "+qa!" || true
	# Never ship an empty plugin cache.
	test -f $(XDG_CONFIG_HOME)/nvim/lazy-lock.json \
	  || { echo "ERROR: lazy-lock.json missing after restore" >&2; exit 1; }
	count=$$(find $(XDG_DATA_HOME)/nvim/lazy -maxdepth 1 -mindepth 1 -type d | wc -l); \
	test "$$count" -ge $(MIN_PLUGINS) \
	  || { echo "ERROR: only $$count plugins restored (expected >= $(MIN_PLUGINS))" >&2; exit 1; }

# Only the generated payload; setup-nvim comes from debian/omakasui-nvim.install.
override_dh_auto_install:
	mkdir -p $(SHARE_DIR)
	cp -a $(XDG_CONFIG_HOME)/nvim $(SHARE_DIR)/config
	cp -a $(XDG_DATA_HOME)/nvim   $(SHARE_DIR)/data
	rm -rf $(SHARE_DIR)/data/site/*
	mkdir -p $(SHARE_DIR)/data/site
	chmod -R 755 $(SHARE_DIR)
	find $(SHARE_DIR) -type f -exec chmod 644 {} +

override_dh_clean:
	dh_clean
	rm -rf $(BUILD_HOME) $(STARTER_TAR) $(CURDIR)/debian/starter-*
